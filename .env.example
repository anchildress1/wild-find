# Copy to .env (gitignored). make loads it.
# Values are unquoted: make reads this file as make syntax, so quotes become part of the value.

# adb device serial; required only when more than one device is attached (see `adb devices`).
ANDROID_SERIAL=

# App id the gate-harness and gate-pull targets use; debug builds carry the .debug suffix.
WILDFIND_PACKAGE=dev.anchildress1.wildfind.debug

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug and release can sit on one phone; the label tells their launcher icons apart. -->
    <application
        android:label="Wild Find (debug)"
        tools:replace="android:label">
        <!-- Debug-only S09 probe; launched over adb by make focus-probe, never from the launcher. -->
        <activity
            android:name=".FocusProbeActivity"
            android:exported="true" />
        <!-- Debug-only gate harness; its own launcher icon starts an untethered field run, and make gate-harness
             starts one over adb with a chosen word. -->
        <!-- Handles its own size and orientation changes: recreation would split one 20-minute run into two. -->
        <activity
            android:name=".harness.GateHarnessActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:label="Wild Find gate"
            android:taskAffinity="dev.anchildress1.wildfind.harness">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

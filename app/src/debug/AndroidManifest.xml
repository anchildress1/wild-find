<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only S09 probe; launched over adb by make focus-probe, never from the launcher. -->
        <activity
            android:name=".FocusProbeActivity"
            android:exported="true" />
        <!-- Debug-only gate harness; launched over adb by make gate-harness, never from the launcher. -->
        <!-- Handles its own size and orientation changes: recreation would split one 20-minute run into two. -->
        <activity
            android:name=".harness.GateHarnessActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true" />
    </application>
</manifest>
